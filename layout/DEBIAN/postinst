#!/bin/bash

if [[ x$JB_ROOT_PATH != x"" ]]; then
    JBROOT="/var/jb"
else
    JBROOT=""
fi
MUBX_SHARED_DIR="$JBROOT/Library/MUBX"
mkdir -p "$MUBX_SHARED_DIR" || true
# Settings runs as mobile and writes the snapshot with an atomic rename, so the
# directory itself (not only shared.plist) must remain writable.
chmod 0777 "$MUBX_SHARED_DIR"

# Move the clipboard database into jbroot so sandboxed app hosts can access it
# directly, matching Kayoko's shared-storage model.
LEGACY_DB="/var/mobile/Library/com.lindo.mubx/clipboard.sqlite"
NEW_DB="$MUBX_SHARED_DIR/clipboard.sqlite"
if [ ! -e "$NEW_DB" ] && [ -e "$LEGACY_DB" ]; then
    cp "$LEGACY_DB" "$NEW_DB" || true
    for suffix in -wal -shm; do
        if [ -e "${LEGACY_DB}${suffix}" ]; then
            cp "${LEGACY_DB}${suffix}" "${NEW_DB}${suffix}" || true
        fi
    done
    chmod 0666 "$NEW_DB" "${NEW_DB}-wal" "${NEW_DB}-shm" 2>/dev/null || true
fi

LEGACY_IMAGES="/var/mobile/Library/com.lindo.mubx/images"
NEW_IMAGES="$MUBX_SHARED_DIR/images"
if [ -d "$LEGACY_IMAGES" ] && [ ! -d "$NEW_IMAGES" ]; then
    mkdir -p "$NEW_IMAGES" || true
    cp -R "$LEGACY_IMAGES"/. "$NEW_IMAGES"/ 2>/dev/null || true
    chmod -R 0777 "$NEW_IMAGES" 2>/dev/null || true
fi

# Seed the shared snapshot from the cfprefsd domain's on-disk plist whenever it
# is missing (fresh install, or shared state deleted before this version).
# Sandboxed app hosts read ONLY this snapshot: without a seed their toolbars
# stay hidden until SpringBoard happens to re-run heal. A bare-dictionary copy
# is the accepted legacy format; the next unsandboxed write replaces it with
# the enveloped format. Never overwrite an existing snapshot -- it may carry
# sandboxed-merge writes (dock toggle) that the domain does not have yet.
DOMAIN_PLIST="/var/mobile/Library/Preferences/com.lindo.mubx.plist"
SHARED_PLIST="$MUBX_SHARED_DIR/shared.plist"
if [ ! -s "$SHARED_PLIST" ] && [ -s "$DOMAIN_PLIST" ]; then
    cp "$DOMAIN_PLIST" "$SHARED_PLIST" || true
    chmod 0644 "$SHARED_PLIST" || true
fi

exit 0
